      "data": {
        "label": "creative-review \u25b8 rules-story-creative-review-round",
        "prompt": "Run Archon sub-workflow `rules-story-creative-review-round` (see rules-story-creative-review-round.json). Inputs: {\"project\": \"$INPUTS.project\", \"options\": \"$INPUTS.options\"}"
