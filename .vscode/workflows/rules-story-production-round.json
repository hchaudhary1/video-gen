      "data": {
        "label": "film-accepted",
        "prompt": "const {emit} = await import(process.cwd() + \"/scripts/archon/rules-story.mjs\");\nawait emit(\"gate\", {kind:\"film\"});"
      },
      "parentId": "group-2",
      "position": {
        "x": 1044,
        "y": 52
      }
    },
    {
