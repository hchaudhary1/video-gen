      "parentId": "group-1",
      "position": {
        "x": 24,
        "y": 52
      }
    },
    {
      "id": "n-film-gate",
      "name": "film-gate",
      "type": "prompt",
      "data": {
        "label": "film-gate",
        "prompt": "const {emit} = await import(process.cwd() + \"/scripts/archon/rules-story.mjs\");\nawait emit(\"gate\", {kind:\"film\"});"
      },
      "parentId": "group-2",
      "position": {
        "x": 24,
        "y": 52
      }
    },
    {
      "id": "n-film-attention",
      "name": "film-attention",
      "type": "askUserQuestion",
      "data": {
        "questionText": "film-attention \u00b7 operator decision \u00b7 if needsAnswer: Review $film-gate.output.artifacts.artifact for $INPUTS.project.",
        "options": [
          {
            "id": "opt-0",
            "label": "Approve",
            "description": "approve"
          },
          {
            "id": "opt-1",
            "label": "Request changes",
            "description": "revise"
          },
          {
            "id": "opt-2",
            "label": "Stop",
            "description": "reject"
          }
        ],
        "outputPorts": 3
      },
      "parentId": "group-2",
      "position": {
        "x": 194,
        "y": 220
      }
    },
    {
      "id": "n-film-answer",
      "name": "film-answer",
      "type": "prompt",
      "data": {
        "label": "film-answer \u00b7 if needsAnswer",
        "prompt": "const {emit} = await import(process.cwd() + \"/scripts/archon/rules-story.mjs\");\nawait emit(\"checkpoint\", {kind:\"film\", expected: process.env.INPUTS_BINDING, answer: JSON.parse(process.env.INPUTS_ANSWER)});"
      },
      "parentId": "group-2",
      "position": {
        "x": 534,
        "y": 220
      }
    },
    {
      "id": "n-film-stop",
      "name": "film-stop",
      "type": "prompt",
      "data": {
        "label": "film-stop \u00b7 stop run \u00b7 if rejected",
        "prompt": "Operator stopped this production; retained artifacts remain available."
      },
      "parentId": "group-2",
      "position": {
        "x": 874,
        "y": 220
      }
    },
    {
