          {
            "id": "opt-0",
            "label": "Approve",
            "description": "approve"
          },
          {
            "id": "opt-1",
            "label": "Request changes",
            "description": "revise"
          },
          {
            "id": "opt-2",
            "label": "Stop",
            "description": "reject"
          }
        ],
        "outputPorts": 3
