    {
      "id": "n-publishing-copy",
      "name": "publishing-copy",
      "type": "subAgent",
      "data": {
        "description": "publishing-copy",
        "agentDefinition": "Archon node `publishing-copy` in rules-story-publishing-cycle-round. Completes only its assigned work.",
        "prompt": "Project: $INPUTS.project. You are executing the active assigned Archon node. This invocation authorizes the work; do not search for a workflow run, start another controller, or stop after reading instructions. Complete the required files/library calls before finishing. Read AGENTS.md, docs/production.md and jobs/scripts/$INPUTS.project/production-profile.json and personalities/rules-story/PROFILE.md. Work only in this project's folders. Follow the applicable repository skill. Preserve supplied recordings, approved narration, evidence and provenance. Never answer human attention on their behalf. Archon owns stage progression. Complete only this node's assignment. Use direct library functions and the documented Archon adapters. Use actual image viewing capability for inspection; disclose unavailable inspection instead of claiming a pass.\nWrite publishing.json in the script project folder with title, description, tags, privacy: unlisted and exact channelId for abdupdates (obtain from operator/config, never invent). Read archon/publishing-decision.json and apply requested copy revisions. Preserve existing approved copy. Include sources. Read docs/publishing.md. This node authors copy only; it does not approve or upload.",
        "agentType": "other",
        "outputPorts": 1
      },
      "parentId": "group-1",
      "position": {
        "x": 24,
        "y": 52
      }
    },
    {
      "id": "n-publishing-gate",
      "name": "publishing-gate",
      "type": "prompt",
      "data": {
        "label": "publishing-gate",
        "prompt": "const {emit} = await import(process.cwd() + \"/scripts/archon/rules-story.mjs\");\nawait emit(\"gate\", {kind:\"publishing\"});"
      },
      "parentId": "group-2",
      "position": {
        "x": 24,
        "y": 52
      }
    },
